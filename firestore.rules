rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public content collections: anyone can read (needed for the live
    // portfolio site), only a signed-in user (your admin account) can write.
    match /{collection}/{docId} {
      allow read: if collection in ['skills', 'education', 'certifications', 'projects'];
      allow write: if request.auth != null
        && collection in ['skills', 'education', 'certifications', 'projects'];
    }
  }
}
